#!/bin/bash
# dock-unlock - make the calcScreen Pi writable again (for updates/changes).
#
# Disables the read-only root overlay and the read-only /boot partition.
# Takes effect after a reboot. Undo with dock-lock.
#
#   sudo dock-unlock            then reboot
#   sudo dock-unlock --reboot   reboot right away
set -euo pipefail

REBOOT=0
for a in "$@"; do
    case $a in
        -r|--reboot) REBOOT=1 ;;
        -h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "dock-unlock: unknown option '$a'" >&2; exit 2 ;;
    esac
done

if [[ $EUID -ne 0 ]]; then
    exec sudo -- "$0" "$@"
fi

die() { echo "dock-unlock: error: $*" >&2; exit 1; }
say() { echo "dock-unlock: $*"; }

command -v raspi-config >/dev/null || die "raspi-config is not installed"

if [[ -f /boot/firmware/cmdline.txt ]]; then BOOT=/boot/firmware; else BOOT=/boot; fi
CMDLINE=$BOOT/cmdline.txt
[[ -f $CMDLINE ]] || die "$CMDLINE not found"

overlay_now() { grep -qw 'overlayroot=tmpfs' /proc/cmdline; }
overlay_conf() { grep -qw 'overlayroot=tmpfs' "$CMDLINE"; }
# fstab line for the boot partition carries ",ro" (raspi-config's convention)
bootro_conf() { grep -E "[[:space:]]$BOOT[[:space:]]" "${1:-/etc/fstab}" | grep -qE 'defaults.*,ro([[:space:],]|$)'; }

changed=0
if overlay_conf; then
    say "disabling the read-only root overlay"
    raspi-config nonint do_overlayfs 1 || die "raspi-config could not disable the overlay"
    changed=1
else
    say "root overlay is already disabled in $CMDLINE"
fi

if overlay_now; then
    # raspi-config cannot change fstab while the overlay is active (the
    # change would land in RAM). Edit the real fstab underneath instead.
    lower=/media/root-ro
    if [[ -f $lower/etc/fstab ]] && bootro_conf "$lower/etc/fstab"; then
        if command -v overlayroot-chroot >/dev/null; then
            say "making $BOOT writable (in the real /etc/fstab)"
            overlayroot-chroot sed -i -e "s#\(.*$BOOT.*\)defaults,ro\(.*\)#\1defaults\2#" /etc/fstab 2>/dev/null ||
                die "could not edit $lower/etc/fstab; after the reboot run 'sudo dock-unlock' again"
            changed=1
        else
            say "after the reboot, run 'sudo dock-unlock' once more to make $BOOT writable"
        fi
    fi
else
    if bootro_conf; then
        say "making $BOOT writable"
        raspi-config nonint disable_bootro || die "raspi-config could not change /etc/fstab"
        changed=1
    fi
    if findmnt -no OPTIONS -M "$BOOT" | grep -qE '(^|,)ro(,|$)'; then
        mount -o remount,rw "$BOOT" && say "$BOOT remounted read-write"
    fi
fi

sync
if overlay_now || ((changed)); then
    if overlay_now; then
        say "unlocked. Reboot to get a writable system:  sudo reboot"
    else
        say "unlocked (already writable now; reboot to apply the boot changes)"
    fi
    say "when you are done, run 'sudo dock-lock' (and reboot) to protect the SD card again"
    if ((REBOOT)) && overlay_now; then
        say "rebooting..."
        systemctl reboot
    fi
else
    say "already unlocked; nothing to do"
fi
